<resources>
    <!-- Facebook Login SDK (Android native sign-in, 2026-08 spec item 2).
         facebook_app_id is the real Smart Publisher app id (matches the
         backend's SOCIAL_FACEBOOK_CLIENT_ID / config/social.php
         providers.facebook.client_id — must always be the same app on
         both sides, since FacebookOAuthProvider::verifyNativeToken()
         rejects any token whose app_id doesn't match).
         facebook_client_token is NOT the App Secret (that must never ship
         in a client build) — it's Meta App Dashboard's separate
         Settings -> Advanced -> "Client token" value. Replace the
         placeholder below before a real device/App-Store build; login
         will fail closed (not silently degrade) until it's set to a real
         value, since the Facebook SDK requires it non-empty at init. -->
    <string name="facebook_app_id">1712079496747110</string>
    <string name="facebook_client_token">ecdc4ad6526a5316cc743e06459b9dd7</string>
    <string name="fb_login_protocol_scheme">fb1712079496747110</string>
